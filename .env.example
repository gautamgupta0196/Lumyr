# Lumyr runs standalone — no backend, no account, no API keys required at build time.
#
# Your Anthropic API key is entered in the app (Settings → Anthropic API key) and
# stored encrypted on your machine via Electron safeStorage. Do NOT put it here.
#
# Everything below is optional.

# Google OAuth — only needed if you want to connect BigQuery via OAuth
# instead of a service account JSON file.
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: crash reporting. Leave unset to disable telemetry entirely.
# SENTRY_DSN=
