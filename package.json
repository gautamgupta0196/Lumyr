{
  "name": "lumyr",
  "version": "1.0.0",
  "description": "Open-source, local-first AI dashboard builder. Bring your own API key.",
  "license": "MIT",
  "homepage": "https://gautamgupta0196.github.io/Lumyr/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gautamgupta0196/Lumyr.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:unpack": "tsc && vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "validate:packaging": "tsx scripts/validate-packaging.ts",
    "build:safe": "npm run validate:packaging && npm run test:unit && npm run build",
    "prepare:python": "bash scripts/prepare-python.sh",
    "prepare:python:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-python.ps1",
    "generate:icons": "bash scripts/generate-icons.sh",
    "generate:icons:win": "powershell -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "build:full": "npm run prepare:python && npm run build",
    "postinstall": "electron-rebuild"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@google-cloud/bigquery": "^7.9.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opencode-ai/sdk": "^1.19.4",
    "opencode-ai": "^1.19.4",
    "@sentry/electron": "^7.7.1",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.7.3",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "^9.14.0",
    "odbc": "^2.5.0",
    "pg": "^8.13.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "snowflake-sdk": "^1.14.0",
    "unzipper": "^0.12.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/archiver": "^7.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.1"
  }
}
